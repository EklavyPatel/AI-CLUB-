DATABASE_URL=sqlite:///./beyond_the_number.db
# Optional alternative for local/server SQLAlchemy deployments. Production uses Cloudflare D1.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Production Cloudflare D1 mode (set platform secrets in Vercel; do not commit values).
# D1_GATEWAY_URL=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev
# D1_GATEWAY_TOKEN=YOUR_PRIVATE_SHARED_SECRET
# Teacher authorization code for restricting teacher account registration.
# TEACHER_SIGNUP_CODE=your_teacher_secret_code
